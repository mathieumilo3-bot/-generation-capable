# ── Variables PUBLIQUES de l'app client (embarquées dans le binaire/bundle : jamais de secret ici) ──
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_APP_ENV=development            # development | staging | production
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:8081
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=        # optionnel (Checkout hébergé par Stripe : pas requis)
EXPO_PUBLIC_SENTRY_DSN=                    # optionnel

# ── Configuration de build (lue par app.config.ts) ──
APP_NAME=Montage
APP_SLUG=montage
APP_SCHEME=montage
APP_BUNDLE_ID=com.example.montage
APP_ANDROID_PACKAGE=com.example.montage
APP_LINK_DOMAIN=app.example.com
APP_VERSION=1.0.0
APP_BUILD_NUMBER=1
EAS_PROJECT_ID=
