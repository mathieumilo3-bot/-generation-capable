# Back-office admin — variables PUBLIQUES uniquement (embarquées dans le bundle navigateur).
# JAMAIS de clé service_role ici : l'autorisation est côté serveur (staff_roles + RLS + RPC admin_*).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# URL publique de l'application cliente : sert à construire le lien d'invitation ${VITE_PUBLIC_APP_URL}/invite/<jeton>
VITE_PUBLIC_APP_URL=https://app.example.com
# development | staging | production (optionnel)
VITE_APP_ENV=development
