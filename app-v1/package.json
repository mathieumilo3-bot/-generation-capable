{
  "name": "app-v1",
  "private": true,
  "version": "1.0.0",
  "description": "Application client (iOS/Android/Web) + back-office + services, au-dessus du moteur vid\u00e9o existant (video-editor/).",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "supabase/functions"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "node scripts/guard.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:sql": "bash supabase/tests/run.sh",
    "test:all": "npm run test && npm run test:sql",
    "client": "npm run start -w @app/client",
    "client:web": "npm run web -w @app/client",
    "admin": "npm run dev -w @app/admin",
    "orchestrator": "npm run start -w @app/orchestrator"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "@types/node": "^22.0.0"
  }
}