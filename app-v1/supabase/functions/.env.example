# Secrets des Edge Functions : `supabase secrets set --env-file supabase/functions/.env` (NE PAS committer .env).
# SUPABASE_URL et les clés par défaut sont injectés par la plateforme ; SB_SECRET_KEY / SB_PUBLISHABLE_KEY les remplacent si vous utilisez les nouvelles clés.
SB_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX
SB_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# Application
APP_WEB_URL=https://app.example.com
APP_SCHEME=montage
ALLOWED_ORIGINS=https://app.example.com,http://localhost:8081
CRON_SECRET=CHANGE_ME_32_CHARS_MIN
PRODUCT_NAME=Montage
SUPPORT_EMAIL=support@example.com

# Stripe (web)
STRIPE_SECRET_KEY=sk_test_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX
# STRIPE_API_VERSION=

# Sign in with Apple (révocation à la suppression du compte) — voir SETUP_REQUIRED.md §Apple
APPLE_TEAM_ID=
APPLE_CLIENT_ID=com.example.montage
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_TOKEN_ENC_KEY=            # openssl rand -base64 32

# Achats in-app Apple (App Store Server API)
APPLE_BUNDLE_ID=com.example.montage
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Achats in-app Google (Play Developer API)
GOOGLE_PACKAGE_NAME=com.example.montage
GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}

# Sandbox / achats de test : JAMAIS en production
STORE_ALLOW_SANDBOX=false

# E-mails
RESEND_API_KEY=
EMAIL_FROM="Montage <no-reply@example.com>"
