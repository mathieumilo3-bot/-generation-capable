# ── Orchestrateur (SERVEUR UNIQUEMENT — ne jamais embarquer ces valeurs dans une app) ──
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SB_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXX          # Supabase → Settings → API Keys → secret key
ENGINE_URL=https://your-engine.fly.dev                 # passerelle moteur (video-editor/apps/web)
ENGINE_TOKEN=CHANGE_ME_32_CHARS_MIN                    # = ENGINE_GATEWAY_TOKEN côté moteur
CRON_SECRET=CHANGE_ME_32_CHARS_MIN                     # = secret CRON_SECRET des Edge Functions (déclenche la recharge automatique)
# FUNCTIONS_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1

WORKER_ID=orch-1
CONCURRENCY=2
LEASE_SECONDS=600
JOB_TIMEOUT_MS=3600000

# Coûts internes (marge) : à calibrer sur l'infrastructure réelle
USD_EUR=0.92
RENDER_COST_MICRO_EUR_PER_SEC=0
STORAGE_COST_MICRO_EUR_PER_GB_MONTH=0

# E-mails transactionnels (optionnel : désactivés si absents)
RESEND_API_KEY=
EMAIL_FROM="Montage <no-reply@example.com>"
PRODUCT_NAME=Montage
SUPPORT_EMAIL=support@example.com
APP_WEB_URL=https://app.example.com
