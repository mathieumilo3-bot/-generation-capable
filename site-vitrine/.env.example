# Resend (https://resend.com) — sending domain must already be verified.
RESEND_API_KEY=
# Where lead notifications from the Capable Audit form are sent.
AUDIT_NOTIFY_EMAIL=
# Optional — defaults to "Génération Capable <audit@generationcapable.fr>".
RESEND_FROM_EMAIL=

# Optional — Google Tag Manager container (GTM-XXXXXXX). Leave empty and no
# analytics script is loaded at all. Once set, GA4 / Google Ads / Meta are
# configured from GTM; the funnel events are already pushed to window.dataLayer.
NEXT_PUBLIC_GTM_ID=
