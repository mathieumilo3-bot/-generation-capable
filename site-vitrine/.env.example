# Resend (https://resend.com) — sending domain must already be verified.
RESEND_API_KEY=
# Where lead notifications from the Capable Audit form are sent.
AUDIT_NOTIFY_EMAIL=
# Optional — defaults to "GC <audit@generationcapable.fr>".
RESEND_FROM_EMAIL=

# Optional — Google Tag Manager container (GTM-XXXXXXX). Leave empty and no
# analytics script is loaded at all. Once set, GA4 / Google Ads / Meta are
# configured from GTM; the funnel events are already pushed to window.dataLayer.
NEXT_PUBLIC_GTM_ID=

# Optional — Snapchat Ads Pixel UUID. The site loads it only after the visitor
# accepts advertising measurement in the consent banner.
NEXT_PUBLIC_SNAP_PIXEL_ID=


# Optional but recommended — enriches the deterministic audit with an OpenAI
# synthesis grounded only in observed/inferred site signals. Contact form PII
# is not sent to OpenAI.
OPENAI_API_KEY=
# Optional — defaults to gpt-5.6-sol.
OPENAI_AUDIT_MODEL=gpt-5.6-sol

# Optional — Google Search Console HTML verification token.
# Paste only the token value, not the full <meta> tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
