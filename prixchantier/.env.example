# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clé publishable (sb_publishable_...) — publique par conception, soumise à la RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_...) — SERVEUR UNIQUEMENT. Jamais exposée au navigateur.
SUPABASE_SECRET_KEY=

# --- Application ------------------------------------------------------------
# URL publique de l'application (sert aux callbacks OAuth et aux liens e-mail).
APP_URL=https://app.prixchantier.fr
# Secret partagé avec Supabase Cron pour appeler /api/cron/tick (>= 24 caractères).
CRON_SECRET=
# Clé AES-256-GCM chiffrant les tokens OAuth en base : `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# --- OpenAI (Structured Outputs) --------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Gmail (Google Cloud Console → OAuth client "Web application") ----------
# Redirect URI : ${APP_URL}/api/mail/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft 365 (Entra ID → App registration) ----------------------------
# Redirect URI : ${APP_URL}/api/mail/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Boîte mail de test locale pour les tests bout-en-bout. Interdite en production.
ENABLE_TEST_MAILBOX=0
